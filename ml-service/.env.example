# Server Configuration
HOST=0.0.0.0
PORT=8000
FLASK_ENV=development
PYTHON_VERSION=3.12.3

# Service Integration
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000

# Model Loading Paths / Caching
LSTM_MODEL_PATH=model_assets/lstm_timeseries.safetensors
FINBERT_MODEL_NAME=ProsusAI/finbert
HF_HOME=./model_cache
TRANSFORMERS_CACHE=./model_cache

# HuggingFace Token (Optional but recommended to prevent rate limits)
HF_TOKEN=your_huggingface_token

# Enable FinBERT deep-learning sentiment analysis
# WARNING: Requires >1GB RAM. Set to false on Render Free Tier (512MB) to prevent OOM crashes.
# Rule-based sentiment (/dsfm/sentiment/rule-based) works without this.
FINBERT_ENABLED=false
